<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:backgroundTint="#422631">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Titolo senza sfondo -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Titolo del vinoooooooooo"
            android:textColor="#FFDAD2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginBottom="24dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Immagine senza sfondo -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="302dp"
            android:layout_height="207dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            app:srcCompat="@drawable/ic_launcher_background" />



        <androidx.cardview.widget.CardView
            android:id="@+id/descriptionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:cardBackgroundColor="@color/md_theme_surfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/background_violet">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description:"
                    android:textColor="#FFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />
                <TextView
                    android:id="@+id/textViewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:justificationMode="inter_word"
                    android:text="Breve descrizione del vino..."
                    android:textColor="#FFFF"
                    android:textSize="20sp"
                    android:lineSpacingExtra="2dp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="4"
                    android:shadowRadius="6" />



            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/ratingCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionCard">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_violet"
                android:padding="20dp"
                tools:layout_editor_absoluteX="29dp"
                tools:layout_editor_absoluteY="527dp">

                <TextView
                    android:id="@+id/textViewTitleRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Rating and price:"
                    android:textColor="#FFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textViewAverageRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="4,5"
                    android:textColor="#FFF394"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textViewTitleRating" />


                <RatingBar
                    android:id="@+id/rating_bar"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="#FFF394"
                    android:rating="4.5"
                    android:stepSize="0.5"
                    app:layout_constraintBottom_toBottomOf="@id/textViewAverageRating"
                    app:layout_constraintStart_toEndOf="@id/textViewAverageRating"
                    app:layout_constraintTop_toTopOf="@id/textViewAverageRating" />

                <TextView
                    android:id="@+id/textViewRatingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="54dp"
                    android:layout_marginTop="3dp"
                    android:text="13057 Voti"
                    android:textColor="#FFF9E2"
                    android:textSize="22sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    app:layout_constraintStart_toStartOf="@id/textViewAverageRating"
                    app:layout_constraintTop_toBottomOf="@id/rating_bar" />

                <!-- Score e Prezzo -->
                <TextView
                    android:id="@+id/textViewScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/score_background"
                    android:padding="8dp"
                    android:text="92"
                    android:textColor="@color/md_theme_scrim"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/textViewAverageRating" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/price_background_yellow"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:text="23,50 €"
                    android:textColor="@color/md_theme_scrim"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/textViewScore"
                    app:layout_constraintTop_toBottomOf="@id/textViewScore" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_pairing"
            android:layout_width="248dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/price_background_yellow"
            android:elevation="8dp"
            android:text="Discover Pairings"
            android:textAllCaps="false"
            android:textColor="#373737"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ratingCard" />



    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.core.widget.NestedScrollView>