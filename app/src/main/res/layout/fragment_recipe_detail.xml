<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Titolo della ricetta -->
        <TextView
            android:id="@+id/text_recipe_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Wild mushroom risotto"
            android:textColor="#FFDAD2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="4"
            android:shadowRadius="6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Immagine della ricetta -->
        <ImageView
            android:id="@+id/image_recipe"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="48dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/recipe_image"
            app:layout_constraintTop_toBottomOf="@id/text_recipe_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Card Container per Informazioni -->
        <androidx.cardview.widget.CardView
            android:id="@+id/infoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/image_recipe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:background="@drawable/background_violet">

                <TextView
                    android:id="@+id/information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/information_heading"
                    android:textColor="#FFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="4"
                    android:shadowRadius="6"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:lineSpacingExtra="7dp" />

                <!-- Tempo di preparazione -->
                <TextView
                    android:id="@+id/text_ready_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Preparation time: 35 min"
                    android:textColor="#FFF9E2"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="4"
                    android:shadowRadius="6"
                    android:layout_marginBottom="14dp"
                    app:layout_constraintTop_toBottomOf="@id/information"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Numero di porzioni -->
                <TextView
                    android:id="@+id/text_servings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Servings: 4"
                    android:textColor="#FFF9E2"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="4"
                    android:shadowRadius="6"
                    app:layout_constraintTop_toBottomOf="@id/text_ready_time"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Bottone ricetta completa -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/text_source_url"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_background"
            android:elevation="8dp"
            android:shadowColor="#88000000"
            android:shadowDx="0.5"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="@string/show_full_recipe"
            android:textAllCaps="false"
            android:textColor="#373737"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoCard" />

        <!-- Bottone valori nutrizionali -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/text_spoonecular"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_background"
            android:elevation="8dp"
            android:shadowColor="#88000000"
            android:shadowDx="0.5"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="@string/more_nutrition_info"
            android:textAllCaps="false"
            android:textColor="#373737"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_source_url" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
