<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_nav_graph.xml"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="it.unimib.winedine.ui.welcome.fragment.LoginFragment"
        tools:layout="@layout/fragment_login"
        android:label="LoginFragment">
    <action
        android:id="@+id/action_loginFragment_to_signupFragment"
        app:destination="@+id/signupFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_loginFragment_to_homeActivity"
            app:destination="@id/homeActivity" />

    </fragment>

    <fragment
        android:id="@id/signupFragment"
        android:name="it.unimib.winedine.ui.welcome.fragment.SignupFragment"
        tools:layout="@layout/fragment_signup"
        android:label="SignUpFragment">
        <action
            android:id="@+id/action_signupFragment_to_homeActivity"
            app:destination="@id/homeActivity" />
    </fragment>
    <activity
        android:id="@+id/homeActivity"
        android:name="it.unimib.winedine.ui.home.HomeActivity"
        android:label="activity_home"
        tools:layout="@layout/activity_home" />


</navigation>