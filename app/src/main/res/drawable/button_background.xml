<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#E8C5BD"
                android:endColor="#FFDAD2"
                android:angle="135" />
            <corners
                android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="#D4B5AD" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#FFDAD2"
                android:endColor="#FFE5DE"
                android:angle="135" />
            <corners
                android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="#E8C5BD" />
        </shape>
    </item>
</selector>